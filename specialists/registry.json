{
  "schemaVersion": 1,
  "packages": {
    "ai-kotlin-backend": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em backends Kotlin/JVM, APIs, persistência, testes e revisão.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-kotlin-backend.git"
      },
      "capabilities": [
        "kotlin",
        "jvm",
        "spring-boot",
        "ktor",
        "gradle",
        "maven",
        "rest-api",
        "persistence",
        "testing"
      ],
      "detection": {
        "files": ["build.gradle.kts", "settings.gradle.kts", "gradlew", "pom.xml"],
        "extensions": [".kt"],
        "packageJsonDependencies": []
      }
    },
    "ai-web-react": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em aplicações React/TypeScript, componentes, estado, testes, acessibilidade e desempenho.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-web-react.git"
      },
      "capabilities": ["react", "typescript", "web", "frontend", "components", "state", "data-fetching", "testing", "accessibility", "performance"],
      "detection": {
        "files": [],
        "extensions": [".tsx", ".jsx"],
        "packageJsonDependencies": ["react"]
      }
    },
    "ai-web-angular": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em aplicações Angular/TypeScript, componentes, signals, RxJS, forms, testes e acessibilidade.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-web-angular.git"
      },
      "capabilities": ["angular", "typescript", "web", "frontend", "components", "signals", "rxjs", "forms", "http", "testing", "accessibility"],
      "detection": {
        "files": ["angular.json"],
        "extensions": [".component.ts", ".component.html"],
        "packageJsonDependencies": ["@angular/core"]
      }
    },
    "ai-kotlin-android": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em aplicações Android/Kotlin, UI, dados offline, plataforma, testes e revisão.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-kotlin-android.git"
      },
      "capabilities": ["android", "kotlin", "jetpack-compose", "views", "coroutines", "offline-first", "testing", "accessibility", "performance"],
      "detection": {
        "files": ["app/src/main/AndroidManifest.xml", "app/build.gradle.kts", "app/build.gradle"],
        "fileNames": ["AndroidManifest.xml"],
        "extensions": [],
        "packageJsonDependencies": []
      }
    },
    "ai-database": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em modelagem, schemas, migrações, integridade, performance e operação segura de bancos.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-database.git"
      },
      "capabilities": ["database", "sql", "schema", "migrations", "data-integrity", "query-performance", "backup-recovery", "security"],
      "detection": {
        "files": ["schema.sql", "flyway.conf", "liquibase.properties", "prisma/schema.prisma"],
        "fileNames": ["schema.sql", "flyway.conf", "liquibase.properties"],
        "extensions": [".sql", ".prisma"],
        "packageJsonDependencies": ["prisma", "@prisma/client", "typeorm", "sequelize", "knex", "drizzle-orm"]
      }
    },
    "ai-sre": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em SLOs, observabilidade, incidentes, capacidade, resiliência e release readiness.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-sre.git"
      },
      "capabilities": ["sre", "slos", "error-budgets", "observability", "incident-response", "capacity", "resilience", "postmortems"],
      "detection": {
        "files": ["slo.yaml", "slos.yaml", "prometheus.yml", "prometheus.yaml", "alertmanager.yml", "alertmanager.yaml"],
        "fileNames": ["slo.yaml", "slos.yaml", "prometheus.yml", "prometheus.yaml", "alertmanager.yml", "alertmanager.yaml", "service.yaml"],
        "extensions": [".slo.yaml", ".slo.yml", ".rules.yaml", ".rules.yml"],
        "packageJsonDependencies": []
      }
    },
    "ai-terraform": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em módulos Terraform, providers, state, segurança, testes e revisão de planos.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-terraform.git"
      },
      "recommendedWith": ["ai-aws", "ai-kubernetes"],
      "capabilities": ["terraform", "hcl", "iac", "modules", "providers", "state", "policy-as-code", "testing", "plan-review"],
      "detection": {
        "files": ["main.tf", "versions.tf", "providers.tf", ".terraform.lock.hcl"],
        "fileNames": ["main.tf", "versions.tf", "providers.tf", ".terraform.lock.hcl"],
        "extensions": [".tf", ".tftest.hcl"],
        "packageJsonDependencies": []
      }
    },
    "ai-aws": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em arquitetura e engenharia AWS alinhadas aos seis pilares Well-Architected.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-aws.git"
      },
      "recommendedWith": ["ai-terraform", "ai-kubernetes"],
      "capabilities": ["aws", "well-architected", "iam", "networking", "compute", "data", "reliability", "cost-optimization", "sustainability", "terraform"],
      "detection": {
        "files": ["template.yaml", "template.yml", "samconfig.toml", "cdk.json", "serverless.yml", "serverless.yaml"],
        "fileNames": ["samconfig.toml", "cdk.json", "serverless.yml", "serverless.yaml"],
        "extensions": [".aws.tf"],
        "packageJsonDependencies": ["aws-cdk-lib", "serverless", "@aws-sdk/client-s3", "@aws-sdk/client-dynamodb"],
        "contentPatterns": [
          {
            "extensions": [".tf", ".tf.json"],
            "regex": "(?:source\\s*=\\s*\"hashicorp/aws\"|provider\\s+\"aws\"|(?:resource|data)\\s+\"aws_)",
            "flags": "u"
          }
        ]
      }
    },
    "ai-kubernetes": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em workloads e plataformas Kubernetes para EKS e ambientes on-premises.",
      "source": {
        "type": "github",
        "repository": "https://github.com/mdnbras/ai-kubernetes.git"
      },
      "recommendedWith": ["ai-aws", "ai-terraform"],
      "capabilities": ["kubernetes", "eks", "on-premises", "workloads", "helm", "kustomize", "networking", "security", "reliability", "upgrades"],
      "detection": {
        "files": ["Chart.yaml", "kustomization.yaml", "kustomization.yml", "helmfile.yaml", "helmfile.yml"],
        "fileNames": ["Chart.yaml", "kustomization.yaml", "kustomization.yml", "helmfile.yaml", "helmfile.yml"],
        "extensions": [],
        "packageJsonDependencies": ["@kubernetes/client-node"],
        "contentPatterns": [
          {
            "extensions": [".yaml", ".yml"],
            "regex": "^apiVersion:\\s*[^\\r\\n]+[\\s\\S]{0,1000}^kind:\\s*(?:Deployment|StatefulSet|DaemonSet|Job|CronJob|Service|Ingress|ConfigMap|Secret|Namespace|CustomResourceDefinition)\\s*$",
            "flags": "mu"
          }
        ]
      }
    }
  }
}
