{
  "schemaVersion": 1,
  "packages": {
    "ai-kotlin-backend": {
      "status": "available",
      "version": "0.1.0",
      "description": "Especialista em backends Kotlin/JVM, APIs, persistência, testes e revisão.",
      "source": {
        "type": "local",
        "path": "../ai-kotlin-backend",
        "repository": null
      },
      "capabilities": [
        "kotlin",
        "jvm",
        "spring-boot",
        "ktor",
        "gradle",
        "maven",
        "rest-api",
        "persistence",
        "testing"
      ],
      "detection": {
        "files": ["build.gradle.kts", "settings.gradle.kts", "gradlew", "pom.xml"],
        "extensions": [".kt"],
        "packageJsonDependencies": []
      }
    },
